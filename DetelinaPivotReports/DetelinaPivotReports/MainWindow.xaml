<Window x:Class="DetelinaPivotReports.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:DetelinaPivotReports.ViewModels"
        mc:Ignorable="d"
        Title="Детелина / Eltrade — Матрични справки за униформи (Размери × Модели)" 
        Height="860" Width="1350" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Roboto, Arial">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Filter Panel -->
            <RowDefinition Height="Auto"/>
            <!-- 2: KPIs & Search -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Pivot Grid -->
            <RowDefinition Height="*"/>
            <!-- 4: Summary Footer Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =================== 0. HEADER =================== -->
        <Border Grid.Row="0" Background="#1F4E79" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2B6CB0" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="TablePivot" Foreground="White" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Детелина / Eltrade BackOffice" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Обобщена матрица за текстил и униформи (Редове: Размери | Колони: Модели)" FontSize="12" Foreground="#CBD5E0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions / Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshMetadataCommand}"
                            ToolTip="Презареди номенклатурите от базата данни"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Презареди"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenSettingsCommand}"
                            ToolTip="Настройки на Firebird връзката и кодировката"
                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#90CDF4" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================== 1. FILTER PANEL =================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Номенклатури (Училище и Терминал) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Артикулна група / Училище -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Училище / Артикулна група:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Plugroups}" 
                                  SelectedItem="{Binding SelectedPlugroup}"
                                  DisplayMemberPath="DisplayName"
                                  IsEditable="True"
                                  materialDesign:HintAssist.Hint="Изберете училище или група..."
                                  FontSize="13"/>
                    </StackPanel>

                    <!-- Чекбокс Включи подгрупи -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding IncludeSubgroups}" 
                              Content="Включи подгрупи" VerticalAlignment="Bottom" Margin="12,0,0,4"
                              ToolTip="Включва и вложените подгрупи (класове) за избраното училище"
                              FontSize="12" Foreground="#4A5568"/>

                    <!-- POS Терминал -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="POS Терминал / Обект:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Terminals}" 
                                  SelectedItem="{Binding SelectedTerminal}"
                                  DisplayMemberPath="DisplayName"
                                  materialDesign:HintAssist.Hint="Всички терминали"
                                  FontSize="13"/>
                    </StackPanel>

                    <!-- Опции за празни размери -->
                    <CheckBox Grid.Column="5" IsChecked="{Binding HideEmptyDays}" 
                              Content="Скриване на празни размери" VerticalAlignment="Bottom" Margin="0,0,0,4"
                              ToolTip="Показва само размерите, за които има регистрирани продажби за периода"
                              FontSize="12" Foreground="#4A5568"/>
                </Grid>

                <!-- Row 2: Период (Бързи бутони + DatePickers) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Бързи бутони за период -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Период:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="Today"
                                Content="Днес" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="Yesterday"
                                Content="Последен 1 ден" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="10Days"
                                Content="10 дни" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="30Days"
                                Content="30 дни" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="50Days"
                                Content="50 дни" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="ThisMonth"
                                Content="Този месец" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>
                    </StackPanel>

                    <!-- Ръчен избор на дати (От дата - До дата) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="От:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="130" Height="32" Margin="0,0,16,0" FontSize="12"/>

                        <TextBlock Text="До:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="130" Height="32" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Действия и Експорт -->
                <DockPanel Grid.Row="4" LastChildFill="False">
                    <!-- Бутон Генерирай -->
                    <Button DockPanel.Dock="Left" Command="{Binding LoadReportCommand}"
                            Background="#1F4E79" BorderBrush="#1F4E79" Foreground="White"
                            Height="40" Padding="20,0" FontWeight="Bold" FontSize="13"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightningBolt" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ИЗВЛЕЧИ СПРАВКА" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Експорт бутони -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding ExportExcelCommand}"
                                Background="#107C41" BorderBrush="#107C41" Foreground="White"
                                Height="36" Padding="14,0" Margin="0,0,8,0" FontSize="12"
                                ToolTip="Експорт на пълната крос-таблица в Microsoft Excel (.xlsx) с форматиране"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Експорт в Excel (.xlsx)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportCsvCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#718096" Foreground="#2D3748"
                                Height="36" Padding="12,0" Margin="0,0,8,0" FontSize="12"
                                ToolTip="Експорт в CSV с UTF-8 BOM и разделител точка и запетая">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDelimitedOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CSV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CopyClipboardCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#718096" Foreground="#2D3748"
                                Height="36" Padding="12,0" FontSize="12"
                                ToolTip="Копиране на таблицата в клипборда за директно поставяне в Excel">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Копирай" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- =================== 2. KPIS & SEARCH =================== -->
        <Grid Grid.Row="2" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Информационни карти (KPIs) -->
            <UniformGrid Grid.Column="0" Columns="4" Margin="0,0,16,0">
                <!-- Карта 1: Общо бройки -->
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ОБЩО ПРОДАДЕНИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding KpiTotalQuantity, StringFormat={}{0:#,##0.##}}" FontSize="18" FontWeight="Bold" Foreground="#1F4E79"/>
                            <TextBlock Text=" бр." FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Карта 2: Уникални модели -->
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="УНИКАЛНИ МОДЕЛИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding KpiUniqueArticles}" FontSize="18" FontWeight="Bold" Foreground="#2B6CB0"/>
                            <TextBlock Text=" модела" FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Карта 3: Активни размери -->
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="АКТИВНИ РАЗМЕРИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding KpiActiveDays}" FontSize="18" FontWeight="Bold" Foreground="#319795"/>
                            <TextBlock Text=" размера" FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Карта 4: Най-търсен размер -->
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ТОП РАЗМЕР" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                        <TextBlock Text="{Binding KpiPeakDate}" FontSize="13" FontWeight="SemiBold" Foreground="#D69E2E" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Бързо филтриране в таблицата (Live Search) -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#A0AEC0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Търсене по размер (напр. 128, M, S)..."
                             BorderThickness="0" VerticalAlignment="Center" FontSize="13"/>

                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                            Visibility="{Binding SearchText, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#A0AEC0" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- =================== 3. PIVOT MATRIX DATA GRID =================== -->
        <Border Grid.Row="3" Margin="20,4,20,4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- Индикатор за зареждане -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" Foreground="#1F4E79"/>
                    <TextBlock Text="Извличане и агрегиране на данни от Firebird..." FontSize="14" FontWeight="Medium" Foreground="#4A5568"/>
                </StackPanel>

                <!-- Празна таблица / Начално състояние -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasReportData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                    <materialDesign:PackIcon Kind="TableSearch" Foreground="#CBD5E0" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Няма заредена справка или няма продажби за избраните филтри." FontSize="14" Foreground="#718096" HorizontalAlignment="Center"/>
                    <TextBlock Text="Изберете училище, период и натиснете „ИЗВЛЕЧИ СПРАВКА“" FontSize="12" Foreground="#A0AEC0" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Основен Pivot DataGrid -->
                <DataGrid x:Name="PivotGrid"
                          ItemsSource="{Binding PivotDataView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="#E2E8F0"
                          RowHeight="28"
                          ColumnHeaderHeight="36"
                          BorderThickness="0"
                          Background="Transparent"
                          AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding [IS_TOTAL_ROW]}" Value="True">
                                    <Setter Property="Background" Value="#EBF8FF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderThickness" Value="0,1.5,0,1.5"/>
                                    <Setter Property="BorderBrush" Value="#2B6CB0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#EDF2F7"/>
                            <Setter Property="Foreground" Value="#2D3748"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#CBD5E0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- 1. Фиксирана колона: Размер -->
                        <DataGridTextColumn Header="Размер" Binding="{Binding [SIZE]}" 
                                            Width="110" SortMemberPath="SORT_ORDER">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1F4E79"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Динамичните колони за всеки модел и крайната колона ОБЩО се добавят в code-behind -->
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- =================== 4. SUMMARY FOOTER BAR =================== -->
        <Border Grid.Row="4" Margin="20,0,20,8" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="6" Padding="16,8"
                Visibility="{Binding HasReportData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Sigma" Foreground="#2B6CB0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="ОБЩО ЗА ПЕРИОДА:" FontWeight="Bold" FontSize="13" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KpiTotalQuantity, StringFormat=' {0:#,##0.##} бр.'}" FontWeight="Bold" FontSize="14" Foreground="#1F4E79" VerticalAlignment="Center"/>
                    <TextBlock Text=" · " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KpiUniqueArticles, StringFormat='{}{0} модела'}" Foreground="#4A5568" VerticalAlignment="Center"/>
                    <TextBlock Text=" в " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KpiActiveDays, StringFormat='{}{0} размера'}" Foreground="#4A5568" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Топ модел: " FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KpiTopArticle}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Топ размер: " FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KpiPeakDate}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- =================== 5. STATUS BAR =================== -->
        <Border Grid.Row="5" Background="#EDF2F7" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E53E3E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#38A169"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding DatabasePathDisplay}" FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="#718096" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Version -->
                <TextBlock Grid.Column="2" Text="v1.0 (Firebird 3.0 · .NET Framework 4.8)" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
