<Window x:Class="DetelinaPivotReports.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:DetelinaPivotReports.ViewModels"
        mc:Ignorable="d"
        Title="Детелина / Eltrade — Аналитични справки за продажби" 
        Height="880" Width="1380" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Roboto, Arial">

    <Window.Resources>
        <!-- Стилизиране за предотвратяване на бели букви върху бял фон в календара и текстовите кутии -->
        <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignDatePicker}">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
        </Style>

        <Style TargetType="{x:Type Calendar}">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style TargetType="{x:Type CalendarButton}">
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Shared Filter Panel -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Tabs Content -->
            <RowDefinition Height="*"/>
            <!-- 3: Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =================== 0. HEADER =================== -->
        <Border Grid.Row="0" Background="#1F4E79" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2B6CB0" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ChartBarStacked" Foreground="White" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Детелина / Eltrade BackOffice" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Справки за продажби: Матрица за текстил и униформи | Детайлна по терминали и бонове" FontSize="12" Foreground="#CBD5E0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions / Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshMetadataCommand}"
                            ToolTip="Презареди номенклатурите от базата данни"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Презареди"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenSettingsCommand}"
                            ToolTip="Настройки на Firebird връзката и кодировката"
                            Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#90CDF4" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================== 1. ОБЩ ПАНЕЛ С ФИЛТРИ (ГОРНА ЛЕНТА) =================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Номенклатури (Училище и Терминал) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Артикулна група / Училище -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Училище / Артикулна група:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Plugroups}" 
                                  SelectedItem="{Binding SelectedPlugroup}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Foreground="#0F172A"
                                  materialDesign:HintAssist.Hint="Всички училища"
                                  FontSize="13"/>
                    </StackPanel>

                    <!-- POS Терминал -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="POS Терминал / Обект:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Terminals}" 
                                  SelectedItem="{Binding SelectedTerminal}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  Foreground="#0F172A"
                                  materialDesign:HintAssist.Hint="Всички терминали"
                                  FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Период (Бързи бутони + DatePickers с часове) + Бутон "ИЗВЛЕЧИ СПРАВКА" -->
                <DockPanel Grid.Row="2" LastChildFill="False">
                    <!-- Лява част: Бързи бутони за период -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Период:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="Today"
                                Content="Днес" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="Yesterday"
                                Content="Последен 1 ден" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="10Days"
                                Content="10 дни" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="30Days"
                                Content="30 дни" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="50Days"
                                Content="50 дни" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding QuickPeriodCommand}" CommandParameter="ThisMonth"
                                Content="Този месец" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="30" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>
                    </StackPanel>

                    <!-- Дясна част: Бутон "ИЗВЛЕЧИ СПРАВКА" -->
                    <Button DockPanel.Dock="Right" Command="{Binding LoadActiveReportCommand}"
                            Background="#1F4E79" BorderBrush="#1F4E79" Foreground="White"
                            Height="38" Padding="20,0" FontWeight="Bold" FontSize="13" Margin="16,0,0,0"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LightningBolt" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ИЗВЛЕЧИ СПРАВКА" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Дясна част (до бутона): Календари От / До с часове -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="От:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Foreground="#0F172A" Width="115" Height="32" Margin="0,0,4,0" FontSize="12"/>
                        <TextBox Text="{Binding StartTime}" Width="48" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip="Начален час (ЧЧ:ММ)" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" CaretBrush="#0F172A" Margin="0,0,12,0"/>

                        <TextBlock Text="До:" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Foreground="#0F172A" Width="115" Height="32" Margin="0,0,4,0" FontSize="12"/>
                        <TextBox Text="{Binding EndTime}" Width="48" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 ToolTip="Краен час (ЧЧ:ММ)" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" CaretBrush="#0F172A"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- =================== 2. TABS CONTENT =================== -->
        <TabControl Grid.Row="2" 
                    SelectedIndex="{Binding SelectedReportIndex, Mode=TwoWay}"
                    Background="#F8FAFC"
                    BorderThickness="0"
                    Padding="0">

            <TabControl.Resources>
                <!-- Стил за лентата с табове -->
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="#173E63"/>
                    <Setter Property="Height" Value="42"/>
                </Style>

                <!-- Стил за самите таб бутони -->
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#CBD5E0"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,3"
                                        BorderBrush="Transparent"
                                        Padding="20,10"
                                        Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1F4E79"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2B6CB0"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#63B3ED"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- =================== ТАБ 1: МАТРИЧНА СПРАВКА ЗА УНИФОРМИ =================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TablePivot" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="1. Матрична справка униформи (Размери × Модели)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: KPIs -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Actions Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Pivot Grid -->
                        <RowDefinition Height="*"/>
                        <!-- 3: Summary Footer Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0: Информационни карти (KPIs) -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="20,12,20,10">
                        <!-- Карта 1: Общо бройки -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОБЩО ПРОДАДЕНИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding KpiTotalQuantity, StringFormat={}{0:#,##0.##}}" FontSize="18" FontWeight="Bold" Foreground="#1F4E79"/>
                                    <TextBlock Text=" бр." FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карта 2: Уникални модели -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="УНИКАЛНИ МОДЕЛИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding KpiUniqueArticles}" FontSize="18" FontWeight="Bold" Foreground="#2B6CB0"/>
                                    <TextBlock Text=" модела" FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карта 3: Активни размери -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="АКТИВНИ РАЗМЕРИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding KpiActiveDays}" FontSize="18" FontWeight="Bold" Foreground="#319795"/>
                                    <TextBlock Text=" размера" FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карта 4: Най-търсен размер -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ТОП РАЗМЕР" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock Text="{Binding KpiPeakDate}" FontSize="13" FontWeight="SemiBold" Foreground="#D69E2E" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 1: Действия и Търсене (Search Box, Чекбокс и Експорт) -->
                    <DockPanel Grid.Row="1" Margin="20,0,20,8" LastChildFill="False">
                        <!-- Търсене по размер -->
                        <Border DockPanel.Dock="Left" Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="10,4" Width="300" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#A0AEC0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="#0F172A" CaretBrush="#0F172A"
                                         materialDesign:HintAssist.Hint="Търсене по размер (напр. 128, M, S)..."
                                         BorderThickness="0" VerticalAlignment="Center" FontSize="13"/>

                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                        Visibility="{Binding SearchText, Converter={StaticResource NotNullToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#A0AEC0" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Скриване на празни размери -->
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding HideEmptyDays}" 
                                  Content="Скриване на празни размери" VerticalAlignment="Center" Margin="16,0,0,0"
                                  ToolTip="Показва само размерите, за които има регистрирани продажби за периода"
                                  FontSize="12" Foreground="#4A5568"/>

                        <!-- Експорт бутони -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ExportExcelCommand}"
                                    Background="#107C41" BorderBrush="#107C41" Foreground="White"
                                    Height="36" Padding="14,0" Margin="0,0,8,0" FontSize="12"
                                    ToolTip="Експорт на пълната крос-таблица в Microsoft Excel (.xlsx) с форматиране"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Експорт в Excel (.xlsx)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#718096" Foreground="#2D3748"
                                    Height="36" Padding="12,0" Margin="0,0,8,0" FontSize="12"
                                    ToolTip="Експорт в CSV с UTF-8 BOM и разделител точка и запетая">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CSV" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CopyClipboardCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#718096" Foreground="#2D3748"
                                    Height="36" Padding="12,0" FontSize="12"
                                    ToolTip="Копиране на таблицата в клипборда за директно поставяне в Excel">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Копирай" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Pivot Matrix DataGrid -->
                    <Border Grid.Row="2" Margin="20,4,20,4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <!-- Индикатор за зареждане -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" Foreground="#1F4E79"/>
                                <TextBlock Text="Извличане и агрегиране на данни от Firebird..." FontSize="14" FontWeight="Medium" Foreground="#4A5568"/>
                            </StackPanel>

                            <!-- Празна таблица / Начално състояние -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasReportData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                                <materialDesign:PackIcon Kind="TableSearch" Foreground="#CBD5E0" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Няма заредена матрична справка или няма продажби за избраните филтри." FontSize="14" Foreground="#718096" HorizontalAlignment="Center"/>
                                <TextBlock Text="Изберете училище, период и натиснете „ИЗВЛЕЧИ СПРАВКА“" FontSize="12" Foreground="#A0AEC0" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Основен Pivot DataGrid -->
                            <DataGrid x:Name="PivotGrid"
                                      ItemsSource="{Binding PivotDataView}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      VerticalGridLinesBrush="#E2E8F0"
                                      RowHeight="28"
                                      ColumnHeaderHeight="36"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      AlternatingRowBackground="#F8FAFC"
                                      HeadersVisibility="Column"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow">

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding [IS_TOTAL_ROW]}" Value="True">
                                                <Setter Property="Background" Value="#EBF8FF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="0,1.5,0,1.5"/>
                                                <Setter Property="BorderBrush" Value="#2B6CB0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="Background" Value="#EDF2F7"/>
                                        <Setter Property="Foreground" Value="#2D3748"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#CBD5E0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <!-- Фиксирана колона: Размер -->
                                    <DataGridTextColumn Header="Размер" Binding="{Binding [SIZE]}" 
                                                        Width="110" SortMemberPath="SORT_ORDER">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#1F4E79"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Динамичните колони за всеки модел и колона ОБЩО се добавят в code-behind -->
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Summary Footer Bar -->
                    <Border Grid.Row="3" Margin="20,0,20,8" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="6" Padding="16,8"
                            Visibility="{Binding HasReportData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Sigma" Foreground="#2B6CB0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ОБЩО ЗА ПЕРИОДА:" FontWeight="Bold" FontSize="13" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiTotalQuantity, StringFormat=' {0:#,##0.##} бр.'}" FontWeight="Bold" FontSize="14" Foreground="#1F4E79" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiUniqueArticles, StringFormat='{}{0} модела'}" Foreground="#4A5568" VerticalAlignment="Center"/>
                                <TextBlock Text=" в " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiActiveDays, StringFormat='{}{0} размера'}" Foreground="#4A5568" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="Топ модел: " FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiTopArticle}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <TextBlock Text="Топ размер: " FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiPeakDate}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- =================== ТАБ 2: ДЕТАЙЛНА СПРАВКА ПРОДАЖБИ ПО ТЕРМИНАЛИ И БОНОВЕ =================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="2. Детайлна справка продажби по терминали и бонове" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: KPIs -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Actions Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Detailed DataGrid -->
                        <RowDefinition Height="*"/>
                        <!-- 3: Summary Footer Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0: Информационни карти (KPIs) -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="20,12,20,10">
                        <!-- Карта 1: Общо бройки (Количество: 0.000) -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОБЩО ПРОДАДЕНИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DetailedKpiTotalQuantity, StringFormat={}{0:#,##0.000}}" FontSize="18" FontWeight="Bold" Foreground="#1F4E79"/>
                                    <TextBlock Text=" бр." FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карта 2: Обща сума ред (Формат: {0:N2} €) -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОБЩА СУМА РЕДОВЕ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock Text="{Binding DetailedKpiTotalRowSum, StringFormat='{}{0:N2} €'}" FontSize="18" FontWeight="Bold" Foreground="#107C41" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Карта 3: Общо бонове -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОБЩО БОНОВЕ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DetailedKpiUniqueBonsCount, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" Foreground="#2B6CB0"/>
                                    <TextBlock Text=" бона" FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карта 4: Общо записи (редове) -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОБЩО ЗАПИСИ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DetailedKpiTotalRowsCount, StringFormat={}{0:#,##0}}" FontSize="18" FontWeight="Bold" Foreground="#718096"/>
                                    <TextBlock Text=" реда" FontSize="12" Foreground="#718096" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 1: Действия и Търсене (Search Box и Експорт) -->
                    <DockPanel Grid.Row="1" Margin="20,0,20,8" LastChildFill="False">
                        <!-- Търсене по бон, артикул, група, терминал -->
                        <Border DockPanel.Dock="Left" Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="8" Padding="10,4" Width="360" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="#A0AEC0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <TextBox Grid.Column="1" Text="{Binding DetailedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="#0F172A" CaretBrush="#0F172A"
                                         materialDesign:HintAssist.Hint="Търсене по бон, артикул, група, терминал..."
                                         BorderThickness="0" VerticalAlignment="Center" FontSize="13"/>

                                <Button Grid.Column="2" Command="{Binding ClearDetailedSearchCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                        Visibility="{Binding DetailedSearchText, Converter={StaticResource NotNullToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#A0AEC0" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Експорт бутони -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ExportDetailedExcelCommand}"
                                    Background="#107C41" BorderBrush="#107C41" Foreground="White"
                                    Height="36" Padding="14,0" Margin="0,0,8,0" FontSize="12"
                                    ToolTip="Експорт на детайлните продажби по бонове в Microsoft Excel (.xlsx)"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Експорт в Excel (.xlsx)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportDetailedCsvCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#718096" Foreground="#2D3748"
                                    Height="36" Padding="12,0" Margin="0,0,8,0" FontSize="12"
                                    ToolTip="Експорт в CSV с UTF-8 BOM и разделител точка и запетая">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CSV" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CopyDetailedClipboardCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#718096" Foreground="#2D3748"
                                    Height="36" Padding="12,0" FontSize="12"
                                    ToolTip="Копиране на детайлните данни в клипборда за директно поставяне в Excel">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Копирай" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Detailed DataGrid -->
                    <Border Grid.Row="2" Margin="20,4,20,4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <!-- Индикатор за зареждане -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" Foreground="#1F4E79"/>
                                <TextBlock Text="Извличане на детайлни продажби по бонове от Firebird..." FontSize="14" FontWeight="Medium" Foreground="#4A5568"/>
                            </StackPanel>

                            <!-- Празна таблица / Начално състояние -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasDetailedData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Foreground="#CBD5E0" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Няма заредени продажби за избраните филтри." FontSize="14" Foreground="#718096" HorizontalAlignment="Center"/>
                                <TextBlock Text="Изберете период, терминал или група и натиснете „ИЗВЛЕЧИ СПРАВКА“" FontSize="12" Foreground="#A0AEC0" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- DataGrid с детайлните записи -->
                            <DataGrid x:Name="DetailedGrid"
                                      ItemsSource="{Binding DetailedDataView}"
                                      Sorting="DetailedGrid_Sorting"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      VerticalGridLinesBrush="#E2E8F0"
                                      RowHeight="28"
                                      ColumnHeaderHeight="36"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      AlternatingRowBackground="{x:Null}"
                                      HeadersVisibility="Column"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow">

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#EDF2F7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlternateReceiptGroup}" Value="True">
                                                <Setter Property="Background" Value="#F4F7FB"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLastInReceipt}" Value="True">
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                <Setter Property="BorderBrush" Value="#A0AEC0"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="Background" Value="#EDF2F7"/>
                                        <Setter Property="Foreground" Value="#2D3748"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="#CBD5E0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <!-- 1. Терминал -->
                                    <DataGridTextColumn Header="Терминал" Binding="{Binding TerminalName}" SortMemberPath="TerminalName" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#4A5568"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirstInReceipt}" Value="False">
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 2. Бон No -->
                                    <DataGridTextColumn Header="Бон No" Binding="{Binding BonNumber}" SortMemberPath="BonNumber" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#2B6CB0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirstInReceipt}" Value="False">
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 3. Дата/Час -->
                                    <DataGridTextColumn Header="Дата/Час" Binding="{Binding SaleDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" SortMemberPath="SaleDateTime" Width="145">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#4A5568"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirstInReceipt}" Value="False">
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 4. Тотал бон (Формат: {0:N2} €) -->
                                    <DataGridTextColumn Header="Тотал бон" Binding="{Binding BonTotal, StringFormat='{}{0:N2} €'}" SortMemberPath="BonTotal" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Foreground" Value="#2D3748"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirstInReceipt}" Value="False">
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 5. Арт.група -->
                                    <DataGridTextColumn Header="Арт.група" Binding="{Binding GroupName}" SortMemberPath="GroupName" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Left"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0,0,0"/>
                                                <Setter Property="Foreground" Value="#4A5568"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirstInReceipt}" Value="False">
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 6. Арт.No -->
                                    <DataGridTextColumn Header="Арт.No" Binding="{Binding PluNumber}" SortMemberPath="PluNumber" Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#718096"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 7. Артикул -->
                                    <DataGridTextColumn Header="Артикул" Binding="{Binding ArticleName}" SortMemberPath="ArticleName" Width="*" MinWidth="180">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Left"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Margin" Value="6,0,0,0"/>
                                                <Setter Property="Foreground" Value="#1A202C"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 8. Количество (Формат: 0.000) -->
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:#,##0.000}}" SortMemberPath="Quantity" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Foreground" Value="#1F4E79"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 9. Ед.цена (Формат: {0:N2} €) -->
                                    <DataGridTextColumn Header="Ед.цена" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} €'}" SortMemberPath="UnitPrice" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Foreground" Value="#4A5568"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 10. Сума ред (Формат: {0:N2} €) -->
                                    <DataGridTextColumn Header="Сума ред" Binding="{Binding RowTotal, StringFormat='{}{0:N2} €'}" SortMemberPath="RowTotal" Width="115">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Foreground" Value="#107C41"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Summary Footer Bar -->
                    <Border Grid.Row="3" Margin="20,0,20,8" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="6" Padding="16,8"
                            Visibility="{Binding HasDetailedData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Sigma" Foreground="#2B6CB0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ОБЩО ЗА ПЕРИОДА (" FontWeight="Bold" FontSize="13" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FormattedPeriodDisplay}" FontWeight="Bold" FontSize="13" Foreground="#1F4E79" VerticalAlignment="Center"/>
                                <TextBlock Text="):" FontWeight="Bold" FontSize="13" Foreground="#2B6CB0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding DetailedKpiTotalQuantity, StringFormat=' {0:#,##0.000} бр.'}" FontWeight="Bold" FontSize="14" Foreground="#1F4E79" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetailedKpiTotalRowSum, StringFormat=' {0:N2} €'}" FontWeight="Bold" FontSize="14" Foreground="#107C41" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetailedKpiUniqueBonsCount, StringFormat='{}{0} бона'}" Foreground="#4A5568" VerticalAlignment="Center"/>
                                <TextBlock Text=" (" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetailedKpiTotalRowsCount, StringFormat='{}{0} продадени реда'}" Foreground="#4A5568" VerticalAlignment="Center"/>
                                <TextBlock Text=")" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="Общ оборот по бонове: " FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetailedKpiTotalBonSum, StringFormat='{}{0:N2} €'}" FontSize="13" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- =================== 3. STATUS BAR =================== -->
        <Border Grid.Row="3" Background="#EDF2F7" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E53E3E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#38A169"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding DatabasePathDisplay}" FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="#718096" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Version -->
                <TextBlock Grid.Column="2" Text="v1.1 (Firebird 3.0 · .NET Framework 4.8)" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
